{% set ns = namespace(count=0, id=0, first_hint=0) %}
{% for c in _all_challenges %}
{% for h in c.hints | default([]) %}
{% set ns.count = ns.count + 1 %}
{% endfor %}
{% endfor %}
count: {{ ns.count }}
results:
{% for c in _all_challenges %}
{% set challenge_id = loop.index %}
{% set ns.first_hint = ns.id + 1 %}
{% for h in c.hints | default([]) %}
{% set ns.id = ns.id + 1 %}
  - id: {{ ns.id }}
    type: standard
    challenge_id: {{ challenge_id }}
    content: {{ h.content | to_json }}
    cost: {{ h.cost }}
{% if h.requires_previous | default(false) and ns.id > ns.first_hint %}
    requirements:
      prerequisites: [{{ range(ns.first_hint, ns.id) | join(', ') }}]
{% else %}
    requirements:
      prerequisites: []
{% endif %}
{% endfor %}
{% endfor %}
meta: {}
